from functools import lru_cache
class Solution:
    def numDistinct(self, s: str, t: str) -> int:
        m = len(s)
        n = len(t)
        @lru_cache(None)
        def dp(i,j):
            if j == n:
                return 1
            if i == m:
                return 0
            take = 0
            if s[i] == t[j]:
                take = dp(i+1,j+1)
            skip = dp(i+1,j)
                
            return take+skip
        return dp(0,0)
            

s = Solution()
p = s.numDistinct(s = "rabbbit", t = "rabbit")
print(p)
        
